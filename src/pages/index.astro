---
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { site, about, projects, experience, education } from "../data/site";

const sections = [
  { id: "about", label: "About" },
  { id: "projects", label: "Projects" },
  { id: "experience", label: "Experience" },
];
const year = new Date().getFullYear();
---

<Base>
  <div class="layout">
    <header class="sidebar">
      <div>
        <h1 class="name">{site.name}</h1>
        <p class="role">{site.title}</p>
        <p class="tagline">{site.tagline}</p>
        <nav class="section-nav" aria-label="Sections">
          <ul>
            {
              sections.map((s) => (
                <li>
                  <a href={`#${s.id}`} data-nav={s.id}>
                    <span class="nav-line" aria-hidden="true" />
                    {s.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
      <ul class="social" aria-label="Links">
        <li><a href={site.links.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
        <li><a href={site.links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
        <li><a href={site.links.resume} target="_blank" rel="noopener noreferrer">Resume</a></li>
        <li><a href={`mailto:${site.links.email}`}>Email</a></li>
      </ul>
    </header>

    <main id="content" tabindex="-1">
      <section id="about" aria-labelledby="about-h">
        <h2 id="about-h" class="section-title">About</h2>
        {about.map((p) => <p>{p}</p>)}
      </section>

      <section id="projects" aria-labelledby="projects-h">
        <h2 id="projects-h" class="section-title">Projects</h2>
        <div class="project-list">
          {projects.map((p) => <ProjectCard project={p} />)}
        </div>
        <p class="more">
          <a href={site.links.github} target="_blank" rel="noopener noreferrer">More on GitHub <span aria-hidden="true">↗</span></a>
        </p>
      </section>

      <section id="experience" aria-labelledby="experience-h">
        <h2 id="experience-h" class="section-title">Experience</h2>
        <ol class="timeline">
          {
            experience.map((job) => (
              <li class="job">
                <p class="job-dates">{job.dates}</p>
                <div>
                  <h3>{job.role}<span class="job-org"> · {job.org}</span></h3>
                  {job.description && <p>{job.description}</p>}
                  {job.tech && (
                    <ul class="tags" aria-label="Technologies">
                      {job.tech.map((t) => <li>{t}</li>)}
                    </ul>
                  )}
                </div>
              </li>
            ))
          }
          <li class="job">
            <p class="job-dates">Education</p>
            <div>
              <h3>{education.school}</h3>
              <p>{education.detail}</p>
            </div>
          </li>
        </ol>
        <p class="more">
          <a href={site.links.resume} target="_blank" rel="noopener noreferrer">View full resume <span aria-hidden="true">↗</span></a>
        </p>
      </section>

      <footer class="footer">
        <p>
          Designed and built by {site.name}, {year}. Layout inspired by{" "}
          <a href="https://brittanychiang.com" target="_blank" rel="noopener noreferrer">Brittany Chiang's site</a>.
          Built with Astro, hosted on Vercel.{" "}
          <a href="https://github.com/ckuudee/portfolio-site" target="_blank" rel="noopener noreferrer">Source</a>.
        </p>
      </footer>
    </main>
  </div>

  <script>
    // Highlight the sidebar link for the section currently in view (desktop sidebar only matters).
    const links = new Map(
      [...document.querySelectorAll<HTMLAnchorElement>("[data-nav]")].map((a) => [a.dataset.nav!, a]),
    );
    // Current = the last section whose top has passed 40% of the viewport; at the very bottom
    // of the page it's the last section, since a short final section may never reach that line.
    const sectionEls = [...links.keys()].map((id) => document.getElementById(id)!).filter(Boolean);
    let ticking = false;
    const update = () => {
      ticking = false;
      const atBottom = innerHeight + scrollY >= document.documentElement.scrollHeight - 2;
      let current = sectionEls[0];
      for (const el of sectionEls) if (el.getBoundingClientRect().top <= innerHeight * 0.4) current = el;
      if (atBottom) current = sectionEls[sectionEls.length - 1];
      links.forEach((a, id) => (id === current.id ? a.setAttribute("aria-current", "true") : a.removeAttribute("aria-current")));
    };
    addEventListener("scroll", () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }, { passive: true });
    update();

    // Hover demos: only on devices with a real hover pointer, and never with reduced motion.
    // The video isn't downloaded until the first hover (sources use data-src, preload="none").
    const canHover = matchMedia("(hover: hover) and (pointer: fine)");
    const reduced = matchMedia("(prefers-reduced-motion: reduce)");
    document.querySelectorAll<HTMLElement>(".project").forEach((card) => {
      const media = card.querySelector<HTMLElement>("[data-demo]");
      const video = media?.querySelector("video");
      if (!media || !video) return;
      const play = () => {
        if (!canHover.matches || reduced.matches) return;
        if (!video.dataset.loaded) {
          video.querySelectorAll<HTMLSourceElement>("source[data-src]").forEach((s) => (s.src = s.dataset.src!));
          video.load();
          video.dataset.loaded = "1";
        }
        media.classList.add("playing");
        video.play().catch(() => media.classList.remove("playing"));
      };
      const stop = () => {
        media.classList.remove("playing");
        video.pause();
      };
      card.addEventListener("mouseenter", play);
      card.addEventListener("mouseleave", stop);
      card.addEventListener("focusin", play);
      card.addEventListener("focusout", stop);
    });
  </script>
</Base>
